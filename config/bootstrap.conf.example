# Copy this file to bootstrap.conf for local overrides.

# Set to false to skip Flatpak and Flathub setup.
# ENABLE_FLATPAK=false

# Set to true to install the Rust toolchain with rustup when cargo is absent.
# ENABLE_RUST=true

# Set to false to skip LazyVim setup.
# ENABLE_LAZYVIM=false

# Location of companion project checkouts.
# PROJECTS_ROOT="$HOME/silentcastle/projects"

# Additional packages to install via DNF.
# EXTRA_PACKAGES=(package1 package2 package3)
